DATABASE_URL=
PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INQUIRY_RATE_LIMIT_SECRET=
TRUST_PROXY_HOPS=1
APP_ID=
APP_SECRET=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
# Identities granted the admin role. OWNER_UNION_IDS accepts a comma-separated
# allowlist so a lost provider account does not lock the owner out permanently.
OWNER_UNION_ID=
OWNER_UNION_IDS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
BASE_PATH=/
# Absolute production origin, e.g. https://example.com (used for canonical URLs and sitemap.xml).
# On Vercel this falls back automatically to VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=
VITE_SITE_URL=
# Contact channels. One local number per market; no country is published as a location.
# VITE_PRIMARY_CHANNEL selects which number the floating button and one-tap actions use.
VITE_PRIMARY_CHANNEL=om
VITE_PHONE_OM_DISPLAY=
VITE_PHONE_OM_TEL=
VITE_PHONE_OM_WHATSAPP=
VITE_PHONE_EG_DISPLAY=
VITE_PHONE_EG_TEL=
VITE_PHONE_EG_WHATSAPP=
VITE_PHONE_SA_DISPLAY=
VITE_PHONE_SA_TEL=
VITE_PHONE_SA_WHATSAPP=
VITE_CONTACT_EMAIL=

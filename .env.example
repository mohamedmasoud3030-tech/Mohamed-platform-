DATABASE_URL=
PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INQUIRY_RATE_LIMIT_SECRET=
TRUST_PROXY_HOPS=1
APP_ID=
APP_SECRET=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
# ── LENA Assistant (optional; AI_FEATURE_SYSTEM.md §10) ──
# Server-side only: never give this key a VITE_ prefix and never read it in the browser bundle.
# Create a RESTRICTED key in Google AI Studio (restricted to the Gemini API) — since
# 2026-06-19 the Gemini API rejects unrestricted keys. Verify with: node tools/verify-gemini.mjs
# Without a key the assistant still answers deterministically from the verified help content.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Identities granted the admin role. OWNER_UNION_IDS accepts a comma-separated
# allowlist so a lost provider account does not lock the owner out permanently.
OWNER_UNION_ID=
OWNER_UNION_IDS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
# Canonical production is an independent LENA origin at the site root.
# Vite `base`, the React router basename, API calls, canonical URLs and the sitemap
# all read this through one helper — do not concatenate it at call sites.
# Optional: BASE_PATH=/lena/ only when this deployment is mounted under a subpath.
BASE_PATH=/
# Absolute LENA production origin (custom domain preferred). Used for canonical URLs and sitemap.xml.
# Never a MALEK domain. Never a GitHub URL. Never an internal preview host used as the brand destination.
# When omitted, Vercel production falls back to VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=
VITE_SITE_URL=
# Contact channels. One local number per market; no country is published as a location.
# VITE_PRIMARY_CHANNEL selects which number the floating button and one-tap actions use.
VITE_PRIMARY_CHANNEL=om
VITE_PHONE_OM_DISPLAY=
VITE_PHONE_OM_TEL=
VITE_PHONE_OM_WHATSAPP=
VITE_PHONE_EG_DISPLAY=
VITE_PHONE_EG_TEL=
VITE_PHONE_EG_WHATSAPP=
VITE_PHONE_SA_DISPLAY=
VITE_PHONE_SA_TEL=
VITE_PHONE_SA_WHATSAPP=
VITE_CONTACT_EMAIL=

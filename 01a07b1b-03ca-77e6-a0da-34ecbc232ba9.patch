+++ b/artifacts/lena/src/styles/screenshots.css
@@ -0,0 +1,116 @@
+/* ==========================================================================
+   LENA Screenshots — Case study gallery styles
+============================================================================ */
+
+/* ─── Desktop screenshots grid ─── */
+.lena-screenshot-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
+  gap: 1.5rem;
+  margin-top: 2rem;
+}
+
+.lena-screenshot {
+  margin: 0;
+  border-radius: 16px;
+  overflow: hidden;
+  border: 1px solid var(--lena-line);
+  background: var(--lena-card);
+  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
+}
+
+.lena-screenshot:hover {
+  transform: translateY(-4px);
+  border-color: var(--lena-line-strong);
+  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.2);
+}
+
+.lena-screenshot img {
+  display: block;
+  width: 100%;
+  height: auto;
+  aspect-ratio: 16 / 10;
+  object-fit: cover;
+  object-position: top left;
+}
+
+.lena-screenshot figcaption {
+  padding: 0.75rem 1rem;
+  font-size: 0.82rem;
+  font-weight: 600;
+  color: var(--lena-muted);
+  text-align: center;
+  border-top: 1px solid var(--lena-line);
+}
+
+/* ─── Mobile screenshots ─── */
+.lena-screenshot-mobile {
+  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
+  max-width: 800px;
+  margin-inline: auto;
+  margin-top: 2rem;
+}
+
+.lena-screenshot-mobile .lena-screenshot img {
+  aspect-ratio: 9 / 16;
+  object-fit: cover;
+  object-position: top center;
+}
+
+/* ─── Features list ─── */
+.lena-features-list {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
+  gap: 1rem;
+  margin-top: 2rem;
+  padding: 0;
+  list-style: none;
+}
+
+.lena-features-list li {
+  display: flex;
+  align-items: flex-start;
+  gap: 0.75rem;
+  padding: 1.25rem;
+  border-radius: 14px;
+  border: 1px solid var(--lena-line);
+  background: var(--lena-card);
+  transition: border-color 0.2s ease;
+}
+
+.lena-features-list li:hover {
+  border-color: var(--lena-line-strong);
+}
+
+.lena-features-list li svg {
+  flex-shrink: 0;
+  color: var(--lena-accent);
+  margin-top: 2px;
+}
+
+.lena-features-list li span {
+  font-size: 0.95rem;
+  line-height: 1.6;
+  color: var(--lena-text);
+}
+
+/* ─── Responsive ─── */
+@media (max-width: 768px) {
+  .lena-screenshot-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .lena-screenshot-mobile {
+    grid-template-columns: repeat(2, 1fr);
+  }
+
+  .lena-features-list {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (max-width: 480px) {
+  .lena-screenshot-mobile {
+    grid-template-columns: 1fr;
+  }
+}

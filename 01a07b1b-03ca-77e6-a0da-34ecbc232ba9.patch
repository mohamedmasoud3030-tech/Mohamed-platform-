+}
+
+.lena-founder-point p {
+  font-size: 0.95rem;
+  line-height: 1.6;
+  opacity: 0.85;
+}
+
+.lena-founder-quote {
+  margin-top: 1.5rem;
+  max-width: 680px;
+  margin-inline: auto;
+  position: relative;
+  padding: 1.5rem 2rem;
+  border-radius: 16px;
+  border: 1px solid var(--lena-line);
+  background: linear-gradient(145deg, var(--lena-card), rgba(7, 14, 34, 0.4));
+}
+
+.lena-founder-quote::before {
+  content: "\201C";
+  position: absolute;
+  top: -0.5rem;
+  inset-inline-start: 1rem;
+  font-size: 5rem;
+  opacity: 0.12;
+  font-family: Georgia, serif;
+  line-height: 1;
+  background: var(--lena-gradient-gold);
+  -webkit-background-clip: text;
+  -webkit-text-fill-color: transparent;
+  background-clip: text;
+}
+
+.lena-founder-quote p {
+  font-size: 1.05rem;
+  line-height: 1.9;
+  font-style: italic;
+  opacity: 0.8;
+}
+
+@media (max-width: 768px) {
+  .lena-founder-points {
+    grid-template-columns: 1fr;
+    gap: 0.75rem;
+  }
+
+  .lena-founder-point {
+    flex-direction: row;
+    text-align: start;
+    padding: 1.25rem 1.5rem;
+  }
+}
+
+/* ─── Timeline ─── */
+.lena-timeline-section {
+  text-align: center;
+}
+
+.lena-timeline {
+  max-width: 640px;
+  margin: 1.5rem auto 0;
+  text-align: start;
+}
+
+.lena-timeline-item {
+  display: flex;
+  gap: 1.5rem;
+  position: relative;
+}
+
+.lena-timeline-marker {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  flex-shrink: 0;
+  width: 20px;
+}
+
+.lena-timeline-dot {
+  width: 14px;
+  height: 14px;
+  border-radius: 50%;
+  background: linear-gradient(135deg, var(--lena-accent, #7b9cff), var(--lena-gold, #ffc76a));
+  box-shadow: 0 0 12px rgba(79, 108, 255, 0.3);
+  flex-shrink: 0;
+}
+
+.lena-timeline-line {
+  width: 2px;
+  flex: 1;
+  background: linear-gradient(to bottom, rgba(79, 108, 255, 0.2), rgba(79, 108, 255, 0.05));
+  min-height: 40px;
+}
+
+.lena-timeline-content {
+  padding-bottom: 1.5rem;
+}
+
+.lena-timeline-year {
+  display: inline-block;
+  font-size: 0.72rem;
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--lena-accent, #7b9cff);

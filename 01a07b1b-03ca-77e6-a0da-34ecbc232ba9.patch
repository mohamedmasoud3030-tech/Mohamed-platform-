+++ b/artifacts/lena/src/styles/mobile-enhancements.css
@@ -0,0 +1,257 @@
+/* ==========================================================================
+   LENA Mobile Enhancements — Touch-friendly interactions and polish
+============================================================================ */
+
+/* ─── Touch-friendly targets ─── */
+@media (pointer: coarse) {
+  .lena-nav-link,
+  .lena-mobile-link,
+  .lena-icon-button,
+  .lena-primary,
+  .lena-secondary,
+  .lena-more {
+    min-height: 48px;
+    min-width: 48px;
+  }
+
+  .lena-form input,
+  .lena-form textarea,
+  .lena-form select {
+    min-height: 48px;
+    font-size: 16px; /* Prevents zoom on iOS */
+  }
+}
+
+/* ─── Mobile menu enhancements ─── */
+.lena-mobile-menu {
+  animation: lena-mobile-menu-slide 0.3s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+@keyframes lena-mobile-menu-slide {
+  from {
+    opacity: 0;
+    transform: translateY(-8px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+.lena-mobile-link {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  padding: 0.875rem 1rem;
+  font-size: 0.95rem;
+  font-weight: 600;
+  border-radius: 12px;
+  transition: background 0.2s ease, color 0.2s ease;
+}
+
+.lena-mobile-link:hover,
+.lena-mobile-link.active {
+  background: rgba(91, 124, 255, 0.12);
+  color: var(--lena-accent);
+}
+
+/* ─── Mobile hero adjustments ─── */
+@media (max-width: 720px) {
+  .lena-hero h1 {
+    font-size: clamp(2rem, 10vw, 2.8rem);
+    line-height: 1.15;
+    letter-spacing: -0.04em;
+  }
+
+  .lena-hero .lena-lead {
+    font-size: 0.95rem;
+    line-height: 1.7;
+  }
+
+  .lena-hero .lena-actions {
+    flex-direction: column;
+    width: 100%;
+  }
+
+  .lena-hero .lena-primary,
+  .lena-hero .lena-secondary {
+    width: 100%;
+    justify-content: center;
+  }
+
+  /* Counters mobile */
+  .lena-counters-row {
+    grid-template-columns: repeat(2, 1fr);
+    gap: 1rem;
+  }
+
+  .lena-counter-value {
+    font-size: 1.75rem;
+  }
+
+  .lena-counter-label {
+    font-size: 0.7rem;
+  }
+
+  /* Timeline mobile */
+  .lena-timeline-item {
+    gap: 1rem;
+  }
+
+  .lena-timeline-content h3 {
+    font-size: 1rem;
+  }
+
+  .lena-timeline-content p {
+    font-size: 0.82rem;
+  }
+
+  /* Founder section mobile */
+  .lena-founder-points {
+    grid-template-columns: 1fr;
+  }
+
+  .lena-founder-point {
+    flex-direction: row;
+    text-align: start;
+    padding: 1.25rem;
+  }
+
+  .lena-founder-quote {
+    padding: 1.5rem;
+  }
+
+  .lena-founder-quote p {
+    font-size: 0.95rem;
+  }
+
+  /* Recommender mobile */
+  .lena-recommender-flow {
+    flex-direction: column;
+  }
+
+  .lena-recommender-option {
+    width: 100%;
+    justify-content: center;
+  }
+
+  /* Service cards mobile */
+  .lena-system-card {
+    padding: 1.5rem;
+  }
+
+  .lena-system-rows {
+    grid-template-columns: 1fr;
+    gap: 1rem;
+  }
+
+  .lena-system-lists {
+    grid-template-columns: 1fr;
+    gap: 1.5rem;
+  }
+
+  /* Footer mobile */
+  .lena-footer-grid {
+    grid-template-columns: 1fr;
+    gap: 2rem;
+  }
+
+  .lena-footer-base {
+    flex-direction: column;
+    align-items: flex-start;
+  }
+}
+
+/* ─── Small mobile (320px-420px) ─── */
+@media (max-width: 420px) {
+  .lena-container {
+    width: calc(100% - 24px);
+  }
+
+  .lena-hero h1 {
+    font-size: clamp(1.8rem, 9vw, 2.4rem);
+  }
+
+  .lena-page-title,
+  .lena-section-title {
+    font-size: clamp(1.6rem, 7vw, 2.2rem);
+  }
+
+  .lena-counters-row {
+    grid-template-columns: 1fr 1fr;
+    gap: 0.75rem;
+  }
+
+  .lena-counter {
+    padding: 1rem 0.5rem;
+  }
+
+  .lena-counter-value {
+    font-size: 1.5rem;
+  }
+
+  .lena-recommender-option {
+    padding: 0.75rem 1rem;
+    font-size: 0.85rem;
+  }
+
+  .lena-founder-point-icon {
+    width: 44px;
+    height: 44px;
+  }
+
+  .lena-timeline-dot {
+    width: 12px;
+    height: 12px;
+  }
+}
+
+/* ─── Tablet (720px-1050px) ─── */
+@media (min-width: 721px) and (max-width: 1050px) {
+  .lena-counters-row {
+    grid-template-columns: repeat(4, 1fr);
+    gap: 1rem;
+  }
+
+  .lena-founder-points {
+    grid-template-columns: repeat(3, 1fr);
+  }
+
+  .lena-recommender-flow {
+    flex-wrap: wrap;
+    justify-content: center;
+  }
+}
+
+/* ─── Safe area insets (notch devices) ─── */
+@supports (padding-top: env(safe-area-inset-top)) {
+  .lena-header {
+    padding-top: max(12px, env(safe-area-inset-top));
+  }
+
+  .lena-footer {
+    padding-bottom: max(16px, env(safe-area-inset-bottom));
+  }
+
+  .lena-whatsapp-fab {
+    right: max(18px, env(safe-area-inset-right));
+    bottom: max(18px, env(safe-area-inset-bottom));
+  }
+
+  [dir="rtl"] .lena-whatsapp-fab {
+    right: auto;
+    left: max(18px, env(safe-area-inset-left));
+  }
+}
+
+/* ─── Landscape mode ─── */
+@media (max-height: 500px) and (orientation: landscape) {
+  .lena-hero {
+    min-height: auto;
+    padding: 2rem 0;
+  }
+
+  .lena-orbit {
+    min-height: 300px;
+  }
+}

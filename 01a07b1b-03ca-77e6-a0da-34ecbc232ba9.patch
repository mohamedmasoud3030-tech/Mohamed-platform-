new file mode 100644
index 0000000..89ddff9
--- /dev/null
+++ b/artifacts/lena/src/styles/enhancements.css
@@ -0,0 +1,311 @@
+/* ==========================================================================
+   LENA Enhancements — Smooth transitions, hover effects, and polish
+============================================================================ */
+
+/* ─── Smooth page transitions ─── */
+.lena-page,
+.lena-section {
+  animation: lena-section-enter 0.6s ease backwards;
+}
+
+@keyframes lena-section-enter {
+  from {
+    opacity: 0;
+    transform: translateY(16px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+/* ─── Service cards DNA colors ─── */
+.lena-system-card[data-system="property"] { --system-dna: blue; }
+.lena-system-card[data-system="wellness"] { --system-dna: pink; }
+.lena-system-card[data-system="rental"] { --system-dna: cyan; }
+.lena-system-card[data-system="investment"] { --system-dna: orange; }
+.lena-system-card[data-system="hospitality"] { --system-dna: violet; }
+.lena-system-card[data-system="recycling"] { --system-dna: lime; }
+
+/* ─── Card hover enhancements ─── */
+.lena-service-card {
+  transition:
+    transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
+    border-color 0.3s ease,
+    box-shadow 0.3s ease;
+}
+
+.lena-service-card:hover {
+  transform: translateY(-6px);
+  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.25);
+}
+
+.lena-service-card .lena-card-glow {
+  transition: opacity 0.4s ease, transform 0.4s ease;
+}
+
+.lena-service-card:hover .lena-card-glow {
+  opacity: 0.35;
+  transform: scale(1.1);
+}
+
+/* ─── Button polish ─── */
+.lena-primary {
+  position: relative;
+  overflow: hidden;
+  transition:
+    transform 0.2s ease,
+    box-shadow 0.3s ease,
+    background 0.3s ease;
+}
+
+.lena-primary::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(
+    135deg,
+    rgba(255, 255, 255, 0.15),
+    transparent 60%
+  );
+  opacity: 0;
+  transition: opacity 0.3s ease;
+}
+
+.lena-primary:hover::before {
+  opacity: 1;
+}
+
+.lena-primary:hover {
+  transform: translateY(-3px);
+  box-shadow: 0 16px 36px rgba(66, 91, 255, 0.35);
+}
+
+/* ─── Navigation link polish ─── */
+.lena-nav-link {
+  position: relative;
+  transition: color 0.2s ease, background 0.2s ease;
+}
+
+.lena-nav-link::after {
+  content: "";
+  position: absolute;
+  bottom: 4px;
+  left: 50%;
+  width: 0;
+  height: 2px;
+  background: var(--lena-accent);
+  transform: translateX(-50%);
+  transition: width 0.25s ease;
+}
+
+.lena-nav-link:hover::after,
+.lena-nav-link.active::after {
+  width: 60%;
+}
+
+/* ─── System rows polish ─── */
+.lena-system-rows dt {
+  font-weight: 700;
+  color: var(--lena-accent);
+  font-size: 0.72rem;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  margin-bottom: 0.25rem;
+}
+
+.lena-system-rows dd {
+  color: var(--lena-muted);
+  font-size: 0.88rem;
+  line-height: 1.7;
+  margin: 0 0 1rem;
+}
+
+/* ─── Roots chip ─── */
+.lena-roots-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.35rem;
+  padding: 0.25rem 0.65rem;
+  border-radius: 99px;
+  font-size: 0.68rem;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  background: rgba(79, 108, 255, 0.1);
+  border: 1px solid rgba(79, 108, 255, 0.15);
+  color: var(--lena-accent);
+}
+
+/* ─── System tagline ─── */
+.lena-system-tagline {
+  font-size: 0.82rem;
+  font-weight: 600;
+  color: var(--lena-gold);
+  margin-top: 0.5rem;
+}
+
+.lena-system-industry {
+  font-size: 0.78rem;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  color: var(--lena-muted);
+  margin-top: 0.5rem;
+}
+
+/* ─── Footer polish ─── */
+.lena-footer-base {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 1rem;
+  margin-top: 2rem;
+  padding-top: 1.5rem;
+  border-top: 1px solid var(--lena-line);
+}
+
+.lena-memory-reset {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  padding: 0.5rem 1rem;
+  border-radius: 12px;
+  border: 1px solid var(--lena-line);
+  background: transparent;
+  color: var(--lena-muted);
+  font-size: 0.72rem;
+  font-weight: 600;
+  cursor: pointer;
+  transition: border-color 0.2s ease, color 0.2s ease;
+}
+
+.lena-memory-reset:hover {
+  border-color: var(--lena-line-strong);
+  color: var(--lena-text);
+}
+
+/* ─── Glass card polish ─── */
+.lena-glass {
+  transition:
+    border-color 0.3s ease,
+    transform 0.3s ease,
+    box-shadow 0.3s ease;
+}
+
+/* ─── Scroll indicator animation ─── */
+.lena-scroll {
+  animation: lena-scroll-bounce 2s ease-in-out infinite;
+}
+
+@keyframes lena-scroll-bounce {
+  0%, 100% { transform: translateY(0); }
+  50% { transform: translateY(6px); }
+}
+
+/* ─── Page entrance ─── */
+.lena-page > * {
+  animation: lena-page-fade-up 0.7s ease backwards;
+}
+
+.lena-page > *:nth-child(1) { animation-delay: 0.1s; }
+.lena-page > *:nth-child(2) { animation-delay: 0.2s; }
+.lena-page > *:nth-child(3) { animation-delay: 0.35s; }
+
+@keyframes lena-page-fade-up {
+  from {
+    opacity: 0;
+    transform: translateY(20px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+/* ─── Scroll-triggered animations ─── */
+.scroll-animate {
+  opacity: 0;
+  transform: translateY(30px);
+  transition:
+    opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
+    transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.scroll-animate.is-visible {
+  opacity: 1;
+  transform: translateY(0);
+}
+
+.scroll-animate-left {
+  opacity: 0;
+  transform: translateX(-40px);
+  transition:
+    opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
+    transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.scroll-animate-left.is-visible {
+  opacity: 1;
+  transform: translateX(0);
+}
+
+.scroll-animate-right {
+  opacity: 0;
+  transform: translateX(40px);
+  transition:
+    opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
+    transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.scroll-animate-right.is-visible {
+  opacity: 1;
+  transform: translateX(0);
+}
+
+.scroll-animate-scale {
+  opacity: 0;
+  transform: scale(0.92);
+  transition:
+    opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
+    transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.scroll-animate-scale.is-visible {
+  opacity: 1;
+  transform: scale(1);
+}
+
+/* Stagger children */
+.scroll-stagger > * {
+  opacity: 0;
+  transform: translateY(20px);
+  transition:
+    opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
+    transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.scroll-stagger.is-visible > *:nth-child(1) { transition-delay: 0.05s; opacity: 1; transform: translateY(0); }
+.scroll-stagger.is-visible > *:nth-child(2) { transition-delay: 0.1s; opacity: 1; transform: translateY(0); }
+.scroll-stagger.is-visible > *:nth-child(3) { transition-delay: 0.15s; opacity: 1; transform: translateY(0); }
+.scroll-stagger.is-visible > *:nth-child(4) { transition-delay: 0.2s; opacity: 1; transform: translateY(0); }
+.scroll-stagger.is-visible > *:nth-child(5) { transition-delay: 0.25s; opacity: 1; transform: translateY(0); }
+.scroll-stagger.is-visible > *:nth-child(6) { transition-delay: 0.3s; opacity: 1; transform: translateY(0); }
+
+/* ─── Reduced motion ─── */
+@media (prefers-reduced-motion: reduce) {
+  .lena-page,
+  .lena-section,
+  .lena-page > *,
+  .lena-scroll {
+    animation: none;
+  }
+
+  .lena-service-card:hover {
+    transform: none;
+  }
+
+  .lena-primary:hover {
+    transform: none;
+  }
+}

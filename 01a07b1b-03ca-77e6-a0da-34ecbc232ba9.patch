+
+.lena-timeline-content h3 {
+  font-size: 1.1rem;
+  font-weight: 700;
+  margin-bottom: 0.35rem;
+}
+
+.lena-timeline-content p {
+  font-size: 0.88rem;
+  line-height: 1.6;
+  opacity: 0.7;

+}
+
+/* ─── Hero entrance animation ─── */
+.lena-hero-copy > * {
+  animation: lena-hero-fade-up 0.8s ease backwards;
+}
+
+.lena-hero-copy > *:nth-child(1) { animation-delay: 0.1s; }
+.lena-hero-copy > *:nth-child(2) { animation-delay: 0.2s; }
+.lena-hero-copy > *:nth-child(3) { animation-delay: 0.3s; }
+.lena-hero-copy > *:nth-child(4) { animation-delay: 0.45s; }
+.lena-hero-copy > *:nth-child(5) { animation-delay: 0.55s; }
+.lena-hero-copy > *:nth-child(6) { animation-delay: 0.65s; }
+
+@keyframes lena-hero-fade-up {
+  from {
+    opacity: 0;
+    transform: translateY(24px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .lena-hero-copy > * {
+    animation: none;
+  }
+}
+
+/* ─── Live Counters ─── */
+.lena-counters-section {
+  padding-block: 1.5rem;
+}
+
+.lena-counters-row {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 1.25rem;
+  max-width: 800px;
+  margin: 0 auto;
+}
+
+.lena-counter {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.35rem;
+  padding: 1.5rem 0.75rem;
+}
+
+.lena-counter-value {
+  font-size: 2.5rem;
+  font-weight: 800;
+  letter-spacing: -0.03em;
+  background: linear-gradient(135deg, var(--lena-accent, #7b9cff), var(--lena-gold, #ffc76a));
+  -webkit-background-clip: text;
+  -webkit-text-fill-color: transparent;
+  background-clip: text;
+  line-height: 1;
+}
+
+.lena-counter-label {
+  font-size: 0.78rem;
+  font-weight: 600;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+  opacity: 0.6;
+}
+
+@media (max-width: 640px) {
+  .lena-counters-row {
+    grid-template-columns: repeat(2, 1fr);
+    gap: 0.75rem;
+  }
+
+  .lena-counter-value {
+    font-size: 2rem;
+  }
+}
+
+/* ─── AI Recommender ─── */
+.lena-recommender {
+  text-align: center;
+}
+
+.lena-recommender-flow {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 0.65rem;
+  margin-top: 1.25rem;
+}
+
+.lena-recommender-option {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  padding: 0.85rem 1.5rem;
+  font-size: 0.9rem;
+  font-weight: 600;
+  cursor: pointer;
+  text-decoration: none;
+  color: inherit;
+  transition: border-color 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
+}
+
+.lena-recommender-option:hover {
+  border-color: var(--lena-accent, #7b9cff);
+  transform: translateY(-2px);
+  box-shadow: 0 8px 24px rgba(79, 108, 255, 0.15);
+}
+
+.lena-recommender-option svg {
+  opacity: 0.4;
+  transition: opacity 0.2s ease, transform 0.2s ease;
+}
+
+.lena-recommender-option:hover svg {
+  opacity: 1;
+  transform: translateX(2px);
+}
+
+/* ─── Founder Promise ─── */
+.lena-founder-section {
+  text-align: center;
+}
+
+.lena-founder-points {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 1rem;
+  margin-top: 1.25rem;
+}
+
+.lena-founder-point {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.75rem;
+  padding: 1.5rem 1.25rem;
+  text-align: center;
+}
+
+.lena-founder-point-icon {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 52px;
+  height: 52px;
+  border-radius: 50%;
+  background: linear-gradient(135deg, rgba(79, 108, 255, 0.15), rgba(255, 199, 106, 0.1));
+  border: 1px solid rgba(79, 108, 255, 0.2);

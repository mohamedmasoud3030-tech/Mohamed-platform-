{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "ignoreCommand": "node -e \"const expected='prj_rtqhzCOdiPlf7yOPAjGvAhhwN6nF';const actual=process.env.VERCEL_PROJECT_ID;if(!actual){console.log('VERCEL_PROJECT_ID unavailable; continuing build');process.exit(1)}if(actual!==expected){console.log('Ignoring deployment: this repository belongs to lena-digital-house only');process.exit(0)}process.exit(1)\"",
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/jiwdah/dist/public",
  "rewrites": [
    {
      "source": "/lena/api",
      "destination": "/api/index?__path="
    },
    {
      "source": "/lena/api/:path*",
      "destination": "/api/index?__path=:path*"
    },
    {
      "source": "/api",
      "destination": "/api/index?__path="
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    },
    {
      "source": "/lena/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/lena/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/lena/lena-og.jpg",
      "destination": "/lena-og.jpg"
    },
    {
      "source": "/lena/founder.jpg",
      "destination": "/founder.jpg"
    },
    {
      "source": "/lena/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/lena/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/lena",
      "destination": "/index.html"
    },
    {
      "source": "/lena/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
